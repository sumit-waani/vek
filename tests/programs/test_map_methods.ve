# Map method tests: all properties and methods + edge cases

# Basic operations
m = {name: "vek", version: "0.1", year: 2024}
print(m.length)
print(m.is_empty)

# Empty map edge cases
empty = {}
print(empty.length)
print(empty.is_empty)

# keys
print(m.keys.length)
for key in m.keys
  print(key)
end

# values
vals = m.values
print(vals.length)

# has
print(m.has("name"))
print(m.has("missing"))
print(m.has("version"))
print(m.has(""))

# has on empty map
print(empty.has("x"))

# delete
d = {a: 1, b: 2, c: 3}
print(d.length)
d.delete("b")
print(d.length)
print(d.has("b"))
print(d.has("a"))
print(d.has("c"))

# delete non-existent key
d.delete("z")
print(d.length)

# delete all keys
d.delete("a")
d.delete("c")
print(d.length)
print(d.is_empty)

# overwrite existing key
ow = {x: 1}
print(ow.x)
ow.x = 99
print(ow.x)
print(ow.length)

# dot access for reading
m2 = {greeting: "hello", count: 42, flag: true}
print(m2.greeting)
print(m2.count)
print(m2.flag)

# bracket access with string key
print(m2["greeting"])
print(m2["count"])

# set via dot
m3 = {}
m3.foo = "bar"
m3.num = 123
print(m3.foo)
print(m3.num)
print(m3.length)

# nested maps
outer = {inner: {val: 42}}
print(outer.inner.val)

# map with different value types
mixed = {a: 1, b: "two", c: true, d: nil, e: [1, 2, 3]}
print(mixed.a)
print(mixed.b)
print(mixed.c)
print(mixed.d)
print(mixed.e.length)

# keys after delete + insert cycle
cycle = {x: 1, y: 2}
cycle.delete("x")
cycle.z = 3
print(cycle.length)
print(cycle.has("x"))
print(cycle.has("y"))
print(cycle.has("z"))

# get
m4 = {a: 10, b: 20, c: 30}
print(m4.get("a"))
print(m4.get("b"))
print(m4.get("missing"))
print(m4.get(""))

# get on empty
print(empty.get("x"))

# set
m5 = {x: 1}
m5.set("y", 2)
print(m5.get("y"))
print(m5.length)
m5.set("x", 99)
print(m5.get("x"))
print(m5.length)

# set on empty
empty.set("first", 1)
print(empty.get("first"))
print(empty.length)

# entries
m6 = {a: 1, b: 2}
e = m6.entries
print(e.length)
print(e[0].length)
print(e[0][0])
print(e[0][1])

# entries on empty
print({}.entries.length)

# merge
m7 = {a: 1, b: 2}
m8 = {b: 3, c: 4}
merged = m7.merge(m8)
print(merged.get("a"))
print(merged.get("b"))
print(merged.get("c"))
print(merged.length)

# merge with empty
m9 = {x: 1}
merged2 = m9.merge({})
print(merged2.get("x"))
print(merged2.length)

merged3 = {}.merge({y: 2})
print(merged3.get("y"))
print(merged3.length)

# merge does not modify originals
print(m7.get("b"))
print(m8.get("b"))
