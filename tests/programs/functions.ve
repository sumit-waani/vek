fn add(a, b)
  return a + b
end
print(add(3, 4))

fn factorial(n)
  if n <= 1
    return 1
  end
  return n * factorial(n - 1)
end
print(factorial(5))
print(factorial(10))

fn counter()
  count = 0
  fn inc()
    count = count + 1
    return count
  end
  return inc
end
c = counter()
print(c())
print(c())
print(c())
