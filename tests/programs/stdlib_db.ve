# Test db (Turso) stdlib package
# Without TURSO_DATABASE_URL set, operations should return nil gracefully

# Try to connect without env vars
result = db.connect()
print(result)

# Query without connection should return nil
rows = db.query("SELECT 1")
print(rows)

# Exec without connection should return nil
exec_result = db.exec("INSERT INTO test VALUES (1)")
print(exec_result)

# Close without connection should not crash
db.close()
print("done")
