# Test jobs package
# Without TURSO_DATABASE_URL set, operations should return nil gracefully

# Test pending count without connection
count = jobs.pending()
print(count)

# Enqueue without connection should return nil
result = jobs.enqueue("send_email", {"to": "user@example.com"})
print(result)

# Register a handler (does not need DB)
fn handle_email(args)
    return true
end

result2 = jobs.process("send_email", handle_email)
print(result2)

# Run one without connection should return nil
run_result = jobs.run_one()
print(run_result)

# Clear without connection should return nil
clear_result = jobs.clear()
print(clear_result)
