# String method tests: all properties and methods + edge cases

# Properties (no args)
print("Hello, World!".length)
print("".length)
print("a".length)

print("hello".upper)
print("HELLO".upper)
print("Hello World".upper)

print("HELLO".lower)
print("hello".lower)
print("Hello World".lower)

print("  spaces  ".trim)
print("no_spaces".trim)
print("   ".trim)
print("".trim)

print("hello".is_empty)
print("".is_empty)

print("hello".reverse)
print("".reverse)
print("a".reverse)
print("abcde".reverse)

print("42".to_i)
print("0".to_i)
print("-7".to_i)
print("abc".to_i)

print("3.14".to_f)
print("0".to_f)
print("abc".to_f)

# contains
print("hello world".contains("world"))
print("hello world".contains("xyz"))
print("hello world".contains(""))
print("hello world".contains("hello world"))
print("a".contains("a"))
print("a".contains("b"))

# starts_with
print("hello".starts_with("hel"))
print("hello".starts_with("hello"))
print("hello".starts_with("xyz"))
print("hello".starts_with(""))

# ends_with
print("hello".ends_with("llo"))
print("hello".ends_with("hello"))
print("hello".ends_with("xyz"))
print("hello".ends_with(""))

# index_of
print("hello".index_of("l"))
print("hello".index_of("o"))
print("hello".index_of("x"))
print("hello".index_of(""))
print("hello".index_of("hello"))

# split
parts = "a,b,c,d".split(",")
print(parts.length)
print(parts.first)
print(parts.last)

words = "hello world foo".split(" ")
print(words.length)
print(words[0])
print(words[1])
print(words[2])

# split with no separator splits into characters
chars = "abc".split("")
print(chars.length)
print(chars[0])
print(chars[1])
print(chars[2])

# split with separator not found
single = "hello".split(",")
print(single.length)
print(single.first)

# replace
print("hello world".replace("world", "vek"))
print("aaa".replace("a", "b"))
print("hello".replace("x", "y"))
print("abc".replace("b", "B"))

# slice
print("hello".slice(1, 3))
print("hello".slice(0, 5))
print("hello".slice(2))
print("hello".slice(0, 0))

# repeat
print("ha".repeat(3))
print("x".repeat(5))
print("abc".repeat(1))
print("abc".repeat(0))
print("".repeat(5))
print("ab".repeat(4))

# pad_left
print("42".pad_left(5, "0"))
print("hello".pad_left(3, "0"))
print("hi".pad_left(5))
print("abc".pad_left(6, "x"))
print("".pad_left(3, "0"))

# pad_right
print("42".pad_right(5, "0"))
print("hello".pad_right(3, "0"))
print("hi".pad_right(5))
print("abc".pad_right(6, "x"))
print("".pad_right(3, "0"))

# to_bytes
b = "abc".to_bytes
print(b.length)
print(b[0])
print(b[1])
print(b[2])
print("".to_bytes.length)

# bytes
by = "abc".bytes
print(by.length)
print(by[0])
print(by[1])
print(by[2])
print("A".bytes[0])

# chars
ch = "abc".chars
print(ch.length)
print(ch[0])
print(ch[1])
print(ch[2])
print("".chars.length)
